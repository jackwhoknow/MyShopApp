# 复制为 .env 后填写真实值，不要提交到代码仓库
# 数据库
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=myshop
DB_USERNAME=myshop
DB_PASSWORD=change-me-db-password

# Redis：验证码、登录限流、token 黑名单与缓存
REDIS_PASSWORD=change-me-redis-password
# 仅本机开发直连时使用，生产可只保留容器内网访问
REDIS_HOST_PORT=6379

# RabbitMQ：秒杀下单排队削峰
RABBITMQ_USERNAME=myshop
RABBITMQ_PASSWORD=change-me-rabbitmq-password
# 仅本机开发直连时使用，生产可只保留容器内网访问
RABBITMQ_HOST_PORT=5673
RABBITMQ_MGMT_HOST_PORT=15673

# JWT 密钥：至少 32 位随机字符串，可用 openssl rand -base64 48 生成
JWT_SECRET=please-change-me-to-a-long-random-secret-at-least-32-chars

# 前端访问地址与支付回调公网地址
CORS_ALLOWED_ORIGINS=https://shop.example.com
PAY_NOTIFY_BASE_URL=https://shop.example.com
WEB_PORT=80

# 仅本地联调模拟支付时置 true，生产必须 false
MOCK_PAYMENT_ENABLED=false

# 支付宝（电脑网站支付）
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=/app/secrets/alipay_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=/app/secrets/alipay_public_key.pem
ALIPAY_RETURN_URL=https://shop.example.com/orders

# 微信支付（APIv3 Native）
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=/app/secrets/wechat_private_key.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_CERT_PATH=/app/secrets/wechat_platform_cert.pem
