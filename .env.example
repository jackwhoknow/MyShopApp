# 复制为 .env 后填写真实值，不要提交到代码仓库
# 数据库
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=myshop
DB_USERNAME=myshop
DB_PASSWORD=change-me-db-password

# Redis：验证码、登录限流、token 黑名单与缓存
REDIS_PASSWORD=change-me-redis-password
# 仅本机开发直连时使用，生产可只保留容器内网访问
REDIS_HOST_PORT=6379

# RabbitMQ：秒杀下单排队削峰
RABBITMQ_USERNAME=myshop
RABBITMQ_PASSWORD=change-me-rabbitmq-password
# 仅本机开发直连时使用，生产可只保留容器内网访问
RABBITMQ_HOST_PORT=5673
RABBITMQ_MGMT_HOST_PORT=15673

# JWT 密钥：至少 32 位随机字符串，可用 openssl rand -base64 48 生成
JWT_SECRET=please-change-me-to-a-long-random-secret-at-least-32-chars

# 默认管理员：仅数据库中不存在该账号时创建；必须提供强密码，未配置则跳过创建
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-admin-password

# 前端访问地址与支付回调公网地址
CORS_ALLOWED_ORIGINS=https://shop.example.com
PAY_NOTIFY_BASE_URL=https://shop.example.com
WEB_PORT=80

# 模拟支付仅在 local/test profile 内通过配置开启，生产 profile 已硬编码关闭，
# 该变量不再生效，保留仅为说明历史配置。
# MOCK_PAYMENT_ENABLED=false

# 支付宝（电脑网站支付）；沙箱环境改为 https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_ENABLED=false
ALIPAY_SERVER_URL=https://openapi.alipay.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_PATH=/app/secrets/alipay_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=/app/secrets/alipay_public_key.pem
ALIPAY_RETURN_URL=https://shop.example.com/orders

# 微信支付（APIv3 Native）
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=/app/secrets/wechat_private_key.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_CERT_PATH=/app/secrets/wechat_platform_cert.pem

# 邮件：找回密码验证码。MAIL_ENABLED=true 时必须填写 HOST/USERNAME/PASSWORD/FROM
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=change-me-smtp-password
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=星耀商城
# 465 端口：SSL=true / STARTTLS=false；587 端口：SSL=false / STARTTLS=true
MAIL_SSL_ENABLED=true
MAIL_STARTTLS_ENABLED=false
MAIL_SMTP_AUTH=true

# 物流查询：生产必须为 kuaidi100（快递100 实时查询），缺 customer/key 会拒绝启动。
# mock 仅供自动化测试使用，不可用于生产。
LOGISTICS_PROVIDER=kuaidi100
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=
KUAIDI100_ENDPOINT=https://poll.kuaidi100.com/poll/query.do

# 图片存储：local=本地磁盘（单机）；s3=MinIO / S3 兼容对象存储（多实例）
UPLOAD_STORAGE=local
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=myshop-uploads
S3_REGION=us-east-1
# 对外访问前缀（CDN 或对象存储公网地址），留空则回退到 endpoint/bucket
S3_PUBLIC_BASE_URL=
